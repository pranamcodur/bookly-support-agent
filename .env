# Copy this file to .env and fill in your key to use the LLM engine.

ANTHROPIC_API_KEY=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

# Optional overrides:
# AGENT_ENGINE=llm            # 'llm' or 'rules'. Defaults to 'llm' if ANTHROPIC_API_KEY is set, else 'rules'.
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_TEMPERATURE=0.2   # optional; omit by default since current models reject it — see README
# PORT=3000

# Zendesk (optional) — set all three to create real tickets instead of mocked
# ones when a customer asks to escalate. See README "Support ticket escalation".
# ZENDESK_SUBDOMAIN=yourcompany
# ZENDESK_EMAIL=agent@yourcompany.com
# ZENDESK_API_TOKEN=xxxxx
